# NX worker is on the licensed engineering workstation, not inside this image.
THERMAL_NX_WORKER_URL=
THERMAL_NX_WORKER_TOKEN=
THERMAL_SERVICE_TOKEN=
THERMAL_BIND_ADDRESS=127.0.0.1
THERMAL_PORT=8790
# CAD import runs in a separate process; exceeding this limit stops that import.
THERMAL_GEOMETRY_TIMEOUT_SECONDS=300
