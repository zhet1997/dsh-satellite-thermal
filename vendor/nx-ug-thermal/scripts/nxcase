#!/usr/bin/env python3
from __future__ import annotations

import sys
import os
from pathlib import Path


SKILL_ROOT = Path(__file__).resolve().parent.parent
RUNTIME_SRC = SKILL_ROOT / "scripts" / "packages" / "ugnxsim" / "src"
if not RUNTIME_SRC.is_dir():
    raise SystemExit(
        "Bundled ugnxsim runtime is missing. Regenerate the Skill bundle before use."
    )
os.environ.setdefault("UGNXSIM_SKILL_ROOT", str(SKILL_ROOT))
sys.path.insert(0, str(RUNTIME_SRC))

from ugnxsim.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
